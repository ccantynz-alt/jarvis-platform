[Unit]
Description=Jarvis Screenshot Service (CDP)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/jarvis
ExecStart=/usr/bin/node src/screenshot-service.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production
EnvironmentFile=/opt/jarvis/config/secrets.env

# Rule 4 safety net (2026-07-20) — spawns a Chromium CDP process per
# capture; headless Chromium is memory-hungry, so this gets more headroom
# than a pure API service. See jarvis-memory.service for the general
# rationale.
# Kept in step with systemd/dropins/jarvis-screenshot.service.d/50-memory.conf (2026-07-30),
# which is what systemd actually enforces on the box. Change both, or neither.
MemoryMax=1536M
MemorySwapMax=256M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
