[Unit]
Description=Jarvis fix-runner — dispatches repair agents for CONFIRMED code-health findings
After=network-online.target jarvis-memory.service jarvis-orchestrator.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/jarvis
# Order matters: fix-runner.env loads second so its values win any collision
# with secrets.env (matches jarvis-code-health.service and jarvis-self-heal.service).
EnvironmentFile=/opt/jarvis/config/secrets.env
EnvironmentFile=/opt/jarvis/config/fix-runner.env
ExecStart=/usr/bin/node src/fix-runner.js
# Type=oneshot DISABLES the start timeout by default, and this tick makes HTTP
# calls to memory and the orchestrator plus a `git remote get-url` per platform.
# A stalled dependency would otherwise leave the unit 'activating' forever and
# systemd would skip every subsequent timer activation — silently, with nothing
# being repaired and every service still green. That is exactly what happened to
# jarvis-fleet-check on 2026-07-30. The default is not a default: set it.
TimeoutStartSec=300

# This unit only DISPATCHES; the repair agents themselves run under the
# orchestrator and are bounded by its own limits. So this stays tiny.
MemoryMax=256M
CPUQuota=50%

# NO [Install] SECTION, deliberately (2026-08-15).
#
# This unit is driven ONLY by its .timer, whose OnBootSec delay exists to stop a
# restart storm becoming a dispatch/review/spawn storm — the timer files say so
# in their own comments. An [Install] WantedBy=multi-user.target defeats that
# completely: once enabled, boot starts this unit immediately and the timer's
# delay never applies, so a reboot dispatched a repair agent at t=0.
#
# The four original oneshots (fleet-check, self-heal, backup, vapron-backup)
# correctly never had one; these five acquired it by copy-paste. Enable the
# .timer, never the .service. test/systemd-invariants.test.js pins this.
