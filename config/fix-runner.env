# Jarvis fix-runner config (src/fix-runner.js) — the thing that turns a
# CONFIRMED code-health finding into a repair agent, unattended.
# Read fresh on every tick, so a change here needs no restart.
#
#   off      = kill switch (no auto-fixing at all; findings still accumulate)
#   dry-run  = pick + log what it WOULD repair, dispatch nothing
#   live     = actually dispatch repair agents
#
# Ships dry-run on purpose, the same way code-health and self-heal did: the
# selection gets read by a human against the real findings table before it is
# allowed to spend agents on Craig's production repos.
FIX_RUNNER_MODE=dry-run

# WARNING: systemd EnvironmentFile does NOT strip inline comments — a comment on
# the same line becomes part of the value, Number() turns it into NaN, and every
# comparison against NaN is false, so the limit stops limiting. That is the
# 2026-07-17 incident (117 self-heal dispatches against a cap of 6). Every value
# below goes through lib/guardrail.js, which takes the leading token and logs
# BAD GUARDRAIL rather than failing open — but keep comments on their OWN lines.

# Fleet-wide repair agents dispatched per day. Deliberately small: each one is a
# full-permission agent committing and pushing to a production repo, and Craig
# reads every result. Raise this only once the results have earned it.
FIX_MAX_PER_DAY=4

# Repairs started in a single tick (also bounded by one-per-platform).
FIX_MAX_CONCURRENT=2

# Severity floor. 'critical' only, to start. Widening to 'high' roughly
# quadruples the eligible pool (94 high vs 25 critical on 2026-08-05), so do it
# deliberately, after the critical pass has proven the loop is safe.
FIX_MIN_SEVERITY=critical
