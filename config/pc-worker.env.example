# Copy to config/pc-worker.env (gitignored — holds a real bearer token).
# Craig gets JARVIS_WORKER_TOKEN from Jarvis (matches JARVIS_WORKER_TOKEN in
# the server's config/secrets.env — ask Jarvis to generate + set both sides).

JARVIS_GATEWAY_URL=https://jarvis.tailbd6217.ts.net:8443
JARVIS_WORKER_TOKEN=
WORKER_ID=pc-craig
WORKSPACE_ROOT=C:\dev
POLL_MS=10000
HEARTBEAT_MS=30000
TIMEOUT_MIN=30

# ── Off-box watchdog (src/pc-worker.js, docs/ALERTS.md) ──────────────────────
# This PC talks to the gateway every 10s from outside the fleet, which makes it
# the fastest box-death detector available — the GitHub Actions watchdog asks for
# every 5 minutes and measurably gets about once an hour.
# Minutes of unreachable gateway before it says anything (rides out a wifi blip
# or a gateway restart):
WATCHDOG_AFTER_MIN=5
# Second opinion that bypasses the tailnet — the box's ONE public liveness port.
PUBLIC_HEALTH_URL=http://66.42.121.161:9212/health
# Third opinion: is this PC online at all? Without this the watchdog would blame
# the box every time the wifi drops.
INTERNET_PROBE_URL=https://1.1.1.1/
# Same ntfy topic as the box's secrets.env. Optional: without it the watchdog
# still logs and pops a desktop message, it just can't reach him when he's away
# from this screen. The topic IS the credential — keep it out of git.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
