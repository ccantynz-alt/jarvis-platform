# Jarvis review-runner config (src/review-runner.js, docs/GOVERNANCE.md) — the
# REVIEW box in the org chart. Read fresh on every tick; no restart needed.
#
#   off      = kill switch (proposals accumulate awaiting review, nothing decided)
#   dry-run  = spawn reviewers and LOG their verdicts, apply nothing
#   live     = apply verdicts through the gate
#
# Ships dry-run: the first officers' verdicts get read by a human against the
# real proposals before any of them is allowed to change state.
REVIEW_RUNNER_MODE=dry-run

# WARNING: systemd EnvironmentFile does NOT strip inline comments — a comment on
# the same line becomes part of the value, Number() turns it into NaN, and every
# comparison against NaN is false, so the limit stops limiting. That is the
# 2026-07-17 incident (117 self-heal dispatches against a cap of 6). Every value
# below goes through lib/guardrail.js — but keep comments on their OWN lines.

# Proposals reviewed per tick. Each is one subscription turn.
REVIEW_MAX_PER_TICK=3

# Wall-clock ceiling per reviewer (minutes). A reviewer reads a diff and answers
# in one line; it does not need an implementer's budget.
REVIEW_TIMEOUT_MIN=10
