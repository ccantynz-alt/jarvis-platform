# Jarvis code-health spine config (src/code-health.js, docs/CODE-HEALTH.md).
# Read fresh on every sweep, so a change here needs no restart.
#   off      = kill switch (no review at all)
#   dry-run  = review + verify + log, but file NOTHING in memory
#   live     = file findings, verify them, and notify
CODE_HEALTH_MODE=live

# WARNING: systemd EnvironmentFile does NOT strip inline comments — a comment on
# the same line becomes part of the value, Number() turns it into NaN, and every
# comparison against NaN is false, so the limit stops limiting. That is the
# 2026-07-17 incident (117 self-heal dispatches against a cap of 6). Every value
# below goes through lib/guardrail.js, which takes the leading token and logs
# BAD GUARDRAIL rather than failing open — but keep comments on their OWN lines.

# hours before the same platform may be swept again (one sweep per platform per
# day-ish, so nine platforms cycle continuously without repeating):
CODE_HEALTH_COOLDOWN_HOURS=20

# most findings taken from a single sweep (worst-first; the rest are dropped, and
# the next sweep on that lens will find them again if they are real):
CODE_HEALTH_MAX_FINDINGS=8

# most adversarial verifier agents spent per sweep. Each one is a subscription
# turn, and verification is what separates a finding from a rumour:
CODE_HEALTH_MAX_VERIFY=4

# per-agent wall-clock ceilings (minutes):
CODE_HEALTH_REVIEW_MIN=25
CODE_HEALTH_VERIFY_MIN=8

# Comma-separated platforms never reviewed. Defaults (when this is unset):
# craig-pc (a worker node, not a codebase), screenshot-to-code (third-party
# fork — findings there are upstream's), vapron (lives on box 158, which nothing
# on this box can SSH to as of 2026-07-30).
#
# universal-ai-operator added 2026-08-05. It is a CrewAI engine whose own source
# is master_engine.py plus a Dockerfile; everything else under its path is
# `target_code/zoobicon` — a WORKING COPY OF THE FLAGSHIP that the operator
# reads and writes (master_engine.py hardcodes that base_dir). Sweeping it filed
# nine of Zoobicon's criticals under the operator's name, against a checkout 194
# commits behind origin/main, while the real `zoobicon` registry path held an
# empty directory — so the flagship was never reviewed under its own name and
# its bugs were attributed to a platform that cannot fix them. Zoobicon now has
# a genuine checkout at /root/zoobicon and is swept as itself. Re-enable this
# only if the operator's OWN code is worth a lens, and then only with the target
# directory excluded.
CODE_HEALTH_SKIP=craig-pc,screenshot-to-code,vapron,universal-ai-operator

# Old CONFIRMED findings re-checked against current code per sweep, oldest-checked
# first. This is the only thing that ever marks a finding `fixed` — without it the
# table only grows and Jarvis keeps reciting bugs Craig already repaired. Each
# re-check is one subscription turn. 0 = never re-check.
CODE_HEALTH_MAX_RECHECK=2

# Minimum age before a confirmed finding is re-checked (hours). Without this a
# sweep re-checks findings it confirmed minutes earlier — a wasted turn.
CODE_HEALTH_RECHECK_MIN_AGE_HOURS=24
