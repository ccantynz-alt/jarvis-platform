# Marco experience self-check (src/experience-check.js).
# Read at process start; the timer starts a fresh process each run, so an edit
# here takes effect on the next tick without a restart.
#
#   off      = kill switch
#   dry-run  = run the checks and log what it WOULD announce; say nothing
#   live     = announce (on change, once daily while unchanged, once on recovery)
#
# Ships LIVE, unlike code-health and fix-runner, and deliberately: this thing
# only ever reads and reports — it dispatches no agents, edits no code, spends
# no subscription turns. The risk being managed here is NOISE, not damage, and
# that is handled structurally in lib/experience.js (announce on change, daily
# while unchanged, never at `alert` level) rather than by keeping it switched
# off. A monitor nobody switched on is the 2026-07-30 watchdog all over again.
EXPERIENCE_MODE=live

# WARNING: systemd EnvironmentFile does NOT strip inline comments (the
# 2026-07-17 guardrail lesson) — keep comments on their OWN lines. This value
# goes through lib/guardrail.js.

# Notifications per hour above which something is considered to be FLOODING him.
# 235 alert-level pushes in 48h (2026-08-10) is the shape this catches; a busy
# afternoon of legitimate agent reports must not trip it.
EXPERIENCE_ALERT_PER_HOUR=12
