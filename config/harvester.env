# Jarvis session harvester config (src/session-harvester.js) — the flywheel.
# Read at process start; the timer starts a fresh process each run, so an edit
# here takes effect on the next tick without any restart.
#
#   off    = kill switch (nothing scanned, nothing spawned)
#   index  = harvest transcript metadata into memory; spend NO agent turns
#   live   = index + distill lessons (HARVEST_DISTILL_MAX agent turns per run)
#
# Ships as `index`, the same road code-health and fix-runner took: the first
# distillations get run by hand and their lessons read by a human before the
# timer is allowed to spend subscription turns unattended.
#
# Flipped to LIVE 2026-08-07, after the first hand-run tick distilled 3
# sessions into 9 lessons that were read against reality: real and specific
# (the systemd StartLimit-in-[Service] gotcha, gluecron's 45 pre-existing tsc
# errors, Traefik's dynamic route files, Craig's auto-mode preference). One of
# the nine was STALE (it named gluecron-update.service, disabled 2026-07-06,
# as the deploy mechanism) and was retired via PATCH /memory/lessons/4 the
# same minute — backlog sessions carry dated knowledge, and the retire path
# is the answer, not a reason to hold the flywheel.
HARVEST_MODE=live

# WARNING: systemd EnvironmentFile does NOT strip inline comments (the
# 2026-07-17 guardrail lesson) — keep comments on their OWN lines. Every value
# below goes through lib/guardrail.js.

# Minutes a transcript must be write-quiet before it counts as a finished
# session. Below this we'd index half a conversation.
HARVEST_QUIET_MIN=10

# Transcripts indexed per run. The first run meets a month of backlog; this
# spreads it over a few hours instead of one giant scan.
HARVEST_MAX_FILES=40

# Distillation agent turns per run. Temporarily 10 (2026-08-08, Craig's call)
# to burn the ~458-session backlog newest-first in ~2 days; the pending queue
# is served newest-first (memory-server /memory/harvest/pending) so current
# knowledge lands before July-era sessions. RESTORE TO 3 once pending ≈ 0 —
# steady state is ~3/hour, in practice far fewer (trivial + conversation
# sessions never reach the queue).
HARVEST_DISTILL_MAX=10

# Minutes per distillation spawn before it is killed.
HARVEST_DISTILL_MIN=6

# Other fleet boxes to pull transcripts from over tailnet SSH (machine:ip,
# comma-separated). Pull-not-push: redaction stays in the ONE tested path here.
HARVEST_REMOTE=vapron-158:100.89.227.39

# Pull Craig's PC transcripts via the read-only PC-worker verbs (1=on, 0=off).
#
# OFF since 2026-08-10, and the reason is architectural rather than a bug to
# patch: the job-row channel TRUNCATES. spawnProcess keeps the last 4000 chars
# of a worker's stdout (by design — a job row is not a file store), so every
# transcript over ~3KB gzipped arrived as its own tail and gunzip refused it
# with "incorrect header check". Craig's real transcripts are 9-11 MB. Carrying
# file payloads through a control channel was the wrong idea, not a wrong
# constant — raising the cap would just move the ceiling.
#
# The clean replacement is the mechanism already used for box 158: rsync over
# the tailnet (the PC is at 100.99.126.88). That needs Windows OpenSSH Server
# installed on the PC, which is Craig's one-time step. Until then the PC leg of
# the flywheel is idle; the box and 158 legs are unaffected.
HARVEST_PC=0
